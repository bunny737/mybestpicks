# Copy to .env (git-ignored) and fill in. Never commit real values.

# Settings module: manage.py defaults to dev; wsgi.py defaults to production.
# Compose/production sets it explicitly.
# DJANGO_SETTINGS_MODULE=mybestpicks.settings.production

SECRET_KEY=replace-with-generated-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://mybestpicks:password@127.0.0.1:5433/mybestpicks
WAGTAILADMIN_BASE_URL=http://localhost:8000
SITE_URL=http://localhost:8000

# Local Docker Compose database (used by compose.yaml; must match DATABASE_URL above).
# Host port 5433 (Windows often reserves 5432). Use 127.0.0.1, not localhost:
# localhost tries IPv6 first and each new connection stalls for seconds.
POSTGRES_DB=mybestpicks
POSTGRES_USER=mybestpicks
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433

# Production only (set in the host's secret store, not in git):
# CSRF_TRUSTED_ORIGINS=https://mybestpicks.in
# MEDIA_ROOT=/app/media
# SECURE_HSTS_SECONDS=3600
# Add ?sslmode=require to DATABASE_URL if the DB provider needs TLS.

# Optional, post-launch (module 14). Never commit a real value:
# TELEGRAM_BOT_TOKEN=
